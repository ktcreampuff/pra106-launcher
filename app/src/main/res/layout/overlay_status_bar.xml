<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="#E6000000"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:text="00:00" />

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/btnWifi"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="0dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="false"
        android:src="@drawable/bar_ic_wifi"
        android:alpha="0.35"
        android:contentDescription="@string/bar_wifi" />

    <ImageView
        android:id="@+id/iconBluetooth"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="false"
        android:src="@drawable/bar_ic_bluetooth"
        android:alpha="0.35"
        android:contentDescription="@string/bar_bluetooth" />

    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:minWidth="48dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="false"
        android:text="@string/bar_skip"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bar_skip_off"
        android:contentDescription="@string/bar_skip_desc" />

    <ImageView
        android:id="@+id/btnPrevApp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="false"
        android:src="@drawable/bar_ic_prev"
        android:contentDescription="@string/bar_prev_app" />

    <ImageView
        android:id="@+id/btnHome"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="false"
        android:src="@drawable/bar_ic_home"
        android:contentDescription="@string/bar_home" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        android:clickable="true"
        android:focusable="false"
        android:src="@drawable/bar_ic_back"
        android:contentDescription="@string/bar_back" />

</LinearLayout>
