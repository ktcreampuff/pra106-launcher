<?xml version="1.0" encoding="utf-8"?>
<!-- 画面右端からスライドして出てくる縦型の操作パネル。通常は隠れていて、ハンドルのタップで表示される。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bar_panel_bg"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="2dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:textColor="#D4D4D4"
        android:textSize="12sp"
        android:text="00:00" />

    <FrameLayout
        android:id="@+id/btnWifi"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/bar_wifi_rescan">
        <ImageView android:id="@+id/iconWifiImg" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/bar_ic_wifi_off" android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/iconBluetooth"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/bar_bluetooth">
        <ImageView android:id="@+id/iconBluetoothImg" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/bar_ic_bluetooth_off" android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnSkip"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/bar_skip_desc">
        <View android:id="@+id/skipDot" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:layout_marginBottom="10dp" android:background="@drawable/bar_skip_off" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="4dp"
            android:text="@string/bar_skip"
            android:textColor="#D4D4D4"
            android:textSize="9sp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <View
        android:layout_width="28dp"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#5A5A5A" />

    <FrameLayout
        android:id="@+id/btnPrevApp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/bar_prev_app">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/bar_ic_prev" android:importantForAccessibility="no" />
        <!-- 長押しで別操作があることを示す目印 -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bar_longpress_hint"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/bar_home">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/bar_ic_home" android:importantForAccessibility="no" />
        <!-- 長押しで別操作があることを示す目印 -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bar_longpress_hint"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@string/bar_back">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/bar_ic_back" android:importantForAccessibility="no" />
    </FrameLayout>

</LinearLayout>
